{
	"name": "compressor-frontend",
	"version": "0.0.0",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/glb-compressor.git",
		"directory": "compressor-frontend"
	},
	"type": "module",
	"scripts": {
		"bd": "bun --bun run build",
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"dev": "vite dev",
		"lint": "eslint .",
		"prepare": "bunx --bun svelte-kit sync",
		"preview": "bun bd && vite preview",
		"test": "vitest run",
		"test:unit": "vitest"
	},
	"dependencies": {
		"vite-robots-txt": "1.0.0",
		"vite-svg-to-ico": "5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "2.1.0",
		"@eslint/js": "10.0.1",
		"@glb-compressor/shared-types": "workspace:*",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.3.0",
		"@vitest/browser-playwright": "4.1.11",
		"eslint": "10.9.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.11.0",
		"playwright": "1.62.1",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"typescript-eslint": "8.68.0",
		"vite": "8.2.2",
		"vite-plugin-devtools-json": "1.1.0",
		"vitest": "4.1.11",
		"vitest-browser-svelte": "3.0.0"
	}
}
