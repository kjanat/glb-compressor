{
	"name": "glb-compressor",
	"version": "1.0.2",
	"description": "Multi-phase GLB/glTF 3D model compression CLI, HTTP server & library",
	"keywords": [
		"glb",
		"gltf",
		"3d",
		"compression",
		"mesh",
		"meshopt",
		"meshoptimizer",
		"gltfpack",
		"draco",
		"webp",
		"avatar",
		"skinned",
		"animation",
		"texture",
		"cli",
		"server",
		"sse",
		"gltf-transform",
		"dreamcli",
		"ansispeck"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/glb-compressor.git"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#pkg": "./package.json",
		"#src/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/types/lib/mod.d.ts",
			"bun": "./dist/bun/lib/mod.js",
			"node": "./dist/node/lib/mod.js",
			"default": "./dist/node/lib/mod.js"
		},
		"./server": {
			"types": "./dist/types/server/main.d.ts",
			"bun": "./dist/bun-bytecode/server/main.cjs",
			"node": "./dist/node/server/main.js",
			"default": "./dist/node/server/main.js"
		},
		"./cli": {
			"types": "./dist/types/cli/main.d.ts",
			"default": "./dist/cli/main.mjs"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/node/lib/mod.js",
	"types": "./dist/types/lib/mod.d.ts",
	"bin": {
		"glb-compressor": "dist/cli/main.mjs",
		"glb-server": "dist/node/server/main.js"
	},
	"files": [
		"dist/node/**/*.*js",
		"dist/bun/**/*.*js",
		"dist/bun-bytecode/**/*.{cjs,cjs.jsc}",
		"dist/types",
		"CHANGELOG.md",
		"skills"
	],
	"scripts": {
		"bd": "bun run build",
		"build": "bun build.ts && tsdown",
		"check": "biome check",
		"cli": "bun --bun cli/main.ts",
		"dev": "bun --hot run server/main.ts",
		"fmt": "dprint fmt",
		"licences": "bunx license-checker --production --json --out licenses.json",
		"lint": "biome lint",
		"prepublishOnly": "bunx prettier README.md --write",
		"start": "bun --bun server/main.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@gltf-transform/core": "4.4.2",
		"@gltf-transform/extensions": "4.4.2",
		"@gltf-transform/functions": "4.4.2",
		"draco3dgltf": "1.5.7",
		"dreamcli": "npm:@kjanat/dreamcli@4.0.0-rc.2",
		"meshoptimizer": "1.2.0",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@types/bun": "1.4.0",
		"@types/draco3dgltf": "1.4.3",
		"ansispeck": "0.4.1",
		"dprint": "0.56.1",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"bun": ">=1.3",
		"node": ">=22.22.2"
	}
}
