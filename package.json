{
	"name": "glb-compressor",
	"version": "1.0.2",
	"description": "Multi-phase GLB/glTF 3D model compression CLI, HTTP server & library",
	"keywords": [
		"glb",
		"gltf",
		"3d",
		"compression",
		"mesh",
		"meshopt",
		"meshoptimizer",
		"gltfpack",
		"draco",
		"webp",
		"avatar",
		"skinned",
		"animation",
		"texture",
		"cli",
		"server",
		"sse",
		"gltf-transform",
		"dreamcli",
		"ansispeck"
	],
	"homepage": "https://glb-compressor.kjanat.com/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/glb-compressor.git"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#pkg": "./package.json",
		"#src/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/types/packages/core/src/mod.d.ts",
			"development": "./packages/core/src/mod.ts",
			"node": "./dist/node/core/src/mod.js",
			"default": "./dist/node/core/src/mod.js"
		},
		"./server": {
			"types": "./dist/types/packages/server/src/main.d.ts",
			"development": "./packages/server/src/main.ts",
			"node": "./dist/node/server/src/main.js",
			"default": "./dist/node/server/src/main.js"
		},
		"./cli": {
			"types": "./dist/types/packages/cli/src/main.d.ts",
			"development": "./packages/cli/src/main.ts",
			"default": "./dist/cli/main.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/node/core/src/mod.js",
	"types": "./dist/types/packages/core/src/mod.d.ts",
	"bin": {
		"glb-compressor": "bin/glb-compressor.js",
		"glb-server": "bin/glb-server.js"
	},
	"files": [
		"bin",
		"src",
		"dist/node/**/*.*js",
		"dist/cli/**/*.*js",
		"dist/types",
		"CHANGELOG.md",
		"skills"
	],
	"workspaces": [
		"packages/*",
		"compressor-frontend",
		"shitty-frontend"
	],
	"scripts": {
		"bd": "npm run build",
		"bench": "node --conditions=development --experimental-strip-types bench.ts",
		"build": "node --experimental-strip-types build.ts",
		"check": "biome check",
		"cli": "node --conditions=development --experimental-strip-types packages/cli/src/main.ts",
		"dev": "concurrently -k \"npm run dev --workspace compressor-frontend\" \"npm run dev --workspace @glb-compressor/server\"",
		"fmt": "dprint fmt",
		"licences": "npx --yes license-checker --production --json --out licenses.json",
		"lint": "biome lint",
		"prepublishOnly": "npx --yes prettier README.md --write",
		"start": "node --conditions=development --experimental-strip-types packages/server/src/main.ts",
		"test": "vitest run test packages/server/test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@gltf-transform/core": "catalog:",
		"@gltf-transform/extensions": "catalog:",
		"@gltf-transform/functions": "catalog:",
		"draco3dgltf": "catalog:",
		"dreamcli": "catalog:",
		"meshoptimizer": "catalog:",
		"sharp": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/draco3dgltf": "catalog:",
		"@types/node": "catalog:",
		"ansispeck": "catalog:",
		"concurrently": "catalog:",
		"dprint": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "4.1.11"
	},
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": ">=24"
	},
	"catalog": {
		"@biomejs/biome": "2.5.10",
		"@gltf-transform/core": "4.4.2",
		"@gltf-transform/extensions": "4.4.2",
		"@gltf-transform/functions": "4.4.2",
		"@types/draco3dgltf": "1.4.3",
		"@types/node": "26.3.0",
		"ansispeck": "0.4.2",
		"concurrently": "10.0.5",
		"dprint": "0.56.1",
		"draco3dgltf": "1.5.7",
		"dreamcli": "npm:@kjanat/dreamcli@^4.0.0-rc.2",
		"meshoptimizer": "1.2.0",
		"sharp": "0.35.4",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	}
}
