{
	"name": "@glb-compressor/core",
	"version": "1.0.2",
	"description": "Multi-phase GLB/glTF 3D model compression library",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kjanat/glb-compressor.git",
		"directory": "packages/core"
	},
	"license": "MIT",
	"type": "module",
	"imports": {
		"#*": "./src/*.ts",
		"#pkg": "./package.json"
	},
	"exports": {
		".": {
			"types": "./dist/types/mod.d.ts",
			"development": "./src/mod.ts",
			"node": "./dist/node/mod.js",
			"default": "./dist/node/mod.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/node/mod.js",
	"types": "./dist/types/mod.d.ts",
	"files": [
		"dist/node/**/*.*js",
		"dist/types"
	],
	"dependencies": {
		"@gltf-transform/core": "catalog:",
		"@gltf-transform/extensions": "catalog:",
		"@gltf-transform/functions": "catalog:",
		"draco3dgltf": "catalog:",
		"meshoptimizer": "catalog:",
		"sharp": "catalog:"
	}
}
