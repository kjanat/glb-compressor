{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat@35d9bb8660321d74ea0457e9f8925a14d15e6800/configs/dprint.remote.json",
	"useTabs": true,
	"yaml": { "printWidth": 180 },
	"markdown": {
		"textWrap": "always",
		"emphasisKind": "asterisks",
		"associations": [".rules", "*.md", "CLAUDE.md", "AGENTS.md"]
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [{
			"command": "bunx tombi format --stdin-filename {{file_path}} -",
			"exts": ["toml"],
		}, {
			"command": "bunx sort-package-json --stdin",
			"fileNames": ["package.json"],
		}, {
			"command": "bunx svgo --final-newline --pretty --indent -1 -q --input - --output -",
			"exts": ["svg"],
		}],
	},
	"excludes": ["**/node_modules", "**/bun.lock"],
	"plugins": ["npm:@dprint/exec@0.7.3/plugin.json@704701df449dd7e942a71144773778ac529d68c2e4657bfc236d393b898b9a67"]
}
