{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://raw.githubusercontent.com/kjanat/kjanat/refs/heads/master/configs/dprint.biome.json",
	"useTabs": true,
	"yaml": { "printWidth": 140 },
	"markdown": {
		"textWrap": "always",
		"emphasisKind": "asterisks",
		"associations": [".rules", "*.md", "CLAUDE.md", "AGENTS.md"]
	},
	"exec": {
		"cwd": "${configDir}",
		"commands": [
			{
				"command": "bunx tombi format --stdin-filename {{file_path}} -",
				"exts": ["toml"]
			},
			{
				"command": "bunx sort-package-json --stdin",
				"fileNames": ["package.json"]
			},
			{
				"command": "bunx svgo --final-newline --pretty -q --input - --output -",
				"exts": ["svg"]
			}
		]
	},
	"excludes": ["**/node_modules", "**/bun.lock"],
	"plugins": [
		"https://plugins.dprint.dev/markdown-0.22.1.wasm",
		"https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
		"https://plugins.dprint.dev/exec-0.7.3.json@a7898d5f1897e77bff474cec3d948c3ec3a7f455e32de2cc60c8adb9a5dd24aa"
	]
}
