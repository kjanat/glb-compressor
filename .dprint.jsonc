{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"extends": "https://cdn.jsdelivr.net/gh/kjanat/kjanat@35d9bb8660321d74ea0457e9f8925a14d15e6800/configs/dprint.remote.json",
	"useTabs": true,
	"yaml": { "printWidth": 180 },
	"markdown": {
		"lineWidth": 120,
		"textWrap": "always",
		"emphasisKind": "asterisks",
		"associations": [".rules", "*.md", "CLAUDE.md", "AGENTS.md"],
		"overrides": [{ "files": ["CHANGELOG.md"], "lineWidth": 999999 }]
	},
	"excludes": ["**/node_modules", "**/bun.lock"],
}
